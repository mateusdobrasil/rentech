{
  "expo": {
    "name": "Rentech",
    "slug": "rentech-mobile",
    "scheme": "rentech",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.rentech.mobile"
    },
    "android": {
      "package": "br.com.rentech.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Use Face ID para desbloquear sua sessão do app Rentech."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "O app Rentech usa a câmera para fotografar avarias no checklist de veículo.",
          "photosPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "O app Rentech usa sua localização para registrar o local de saída e retorno do checklist de veículo."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#336699"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d27080dd-4585-4933-ace9-8281357eae23"
      }
    },
    "owner": "mateusdobrasil"
  }
}
