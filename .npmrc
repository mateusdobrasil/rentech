# mobile/ (Expo/React Native) trava a resolução de vários pacotes (ex.:
# babel-preset-expo -> expo-router) via require.resolve() relativo à própria
# localização do pacote no disco — isso quebra se o npm decidir "hoistar"
# alguns pacotes pra raiz do monorepo e deixar outros aninhados dentro de
# mobile/node_modules (dependência fica "invisível" pra quem foi hoisted).
# install-strategy=nested mantém cada workspace com sua própria árvore de
# node_modules completa e autocontida, evitando esse tipo de bug de
# resolução cruzada entre workspaces.
install-strategy=nested
